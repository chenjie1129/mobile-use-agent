#!/usr/bin/env bash
# mua - Mobile Use Agent CLI 全局入口
#
# 用法:
#   mua                     # 交互式菜单
#   mua setup               # 配置 AK/SK (可选默认手机)
#   mua run                 # 问答式向导运行任务
#   mua run --prompt "..." --product-id PID --pod-id POD
#   mua status --run-id RUN_XXX
#   mua result / cancel / list / whoami / device / logout
#
# 安装: 在 skill 根目录执行 ./install.sh (软链本脚本到 ~/.local/bin/mua)
# 本脚本支持被软链接调用 (自动解析真实路径)。

# --- 解析脚本真实路径 (兼容软链接) ---
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SKILL_DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

# --- 查找可用的 Python (能 import volcenginesdkcore 的优先) ---
PY=""
for candidate in \
  "${HOME}/.workbuddy/binaries/python/envs/default/bin/python" \
  "$(command -v python3)" \
  "$(command -v python)"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    if "$candidate" -c "import volcenginesdkcore" >/dev/null 2>&1; then
      PY="$candidate"
      break
    fi
  fi
done

# 兜底: 找不到带 SDK 的 python, 用第一个可用的 python3
if [ -z "$PY" ]; then
  for candidate in "$(command -v python3)" "$(command -v python)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      PY="$candidate"
      break
    fi
  done
fi

if [ -z "$PY" ]; then
  echo "错误: 未找到 Python 3, 请先安装 (https://www.python.org/downloads/)" >&2
  exit 1
fi

# SDK 缺失提示
if ! "$PY" -c "import volcenginesdkcore" >/dev/null 2>&1; then
  echo "提示: 缺少 Python 依赖, 正在检查... (首次使用需安装)" >&2
  "$PY" -m pip install -r "$SKILL_DIR/requirements.txt" >&2 || {
    echo "错误: 依赖安装失败, 请手动执行: pip install -r $SKILL_DIR/requirements.txt" >&2
    exit 1
  }
fi

exec "$PY" "$SKILL_DIR/scripts/cli.py" "$@"
